APP_NAME=EcoPower
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Même base MySQL que l'ancien serveur Express
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecopower_db
DB_USERNAME=root
DB_PASSWORD=

# Pas de session ni de file d'attente : le site est une SPA + API JSON
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Sécurité admin (reprendre la valeur JWT_SECRET de l'ancien .env pour garder les sessions admin)
JWT_SECRET=change_me_64_hex_chars
ADMIN_EMAIL=admin@ecopower.tn
ADMIN_PASSWORD=admin123
