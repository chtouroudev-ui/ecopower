{
    admin 127.0.0.1:2019
}

https://stock-manager.nelyio.local:9050, https://localhost:9050 {
    tls internal
    encode zstd gzip

    reverse_proxy 127.0.0.1:9051

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options SAMEORIGIN
        -Server
    }

    # Access logging is disabled by default in production to avoid one JSON disk
    # write per request. Nelyio still records backend requests slower than the
    # configured threshold in logs/http_slow.log.
}
